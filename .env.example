# ---- AI (server-side only; never prefix with NEXT_PUBLIC_) ----
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the Claude model (defaults to claude-opus-5).
# EUROCV_MODEL=claude-opus-5

# ---- Payments (Paddle Billing) — see docs/PAYMENTS.md ----
# "sandbox" for testing with fake cards, "production" for real money.
PADDLE_ENVIRONMENT=sandbox
# Server-side API key from Paddle > Developer tools > Authentication.
PADDLE_API_KEY=
# Client-side token (safe to expose) from the same page.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Price ID of the €4.99 one-time "EuroCV Pro" price (pri_...).
NEXT_PUBLIC_PADDLE_PRICE_ID=
# Random string (32+ chars) used to sign the Pro cookie. Required in production.
EUROCV_SESSION_SECRET=

# Local development only: lets the checkout page grant Pro without paying.
# EUROCV_DEV_UNLOCK=true

# Public site URL used for metadata and sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
